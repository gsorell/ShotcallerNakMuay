<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name">Shotcaller Nak Muay</string>
    <string name="title_activity_main">Shotcaller Nak Muay</string>
    <string name="package_name">com.shotcallernakmuay.app</string>
    <string name="custom_url_scheme">com.shotcallernakmuay.app</string>

    <!--
        Meta app credentials, read by the SDK out of the manifest at startup.

        Neither is a secret: both ship inside the APK by design and can be read
        out of any published build. They live here, in the clear, because that
        is where Meta's SDK looks and because hiding them would buy nothing.

        Both are still PLACEHOLDERS. Get the real values from
        developers.facebook.com -> the app -> Settings -> Basic (App ID at the
        top, Client Token under Advanced). Until they are replaced, a release
        build fails on purpose - see checkMetaCredentials in build.gradle.
    -->
    <string name="facebook_app_id">REPLACE_WITH_META_APP_ID</string>
    <string name="facebook_client_token">REPLACE_WITH_META_CLIENT_TOKEN</string>
</resources>
